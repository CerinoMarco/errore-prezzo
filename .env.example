# Copia questo file in ".env" e riempi i due valori.
# Il bot manda gli alert a QUESTA chat.
#
# 1) Su Telegram scrivi a @BotFather -> /newbot -> copia il TOKEN qui sotto.
# 2) Manda un messaggio qualsiasi al tuo nuovo bot.
# 3) Apri  https://api.telegram.org/bot<IL_TUO_TOKEN>/getUpdates
#    e copia il numero "chat":{"id": ...} in TG_CHAT.
#
# Se lasci vuoto, il monitor gira in "dry-run" e stampa gli alert a schermo.

TG_TOKEN=
TG_CHAT=

# --- (OPZIONALE) Ponte email -> Telegram per gli alert Amazon di CamelCamelCamel ---
# Usa una email DEDICATA, NON la tua personale. Per Gmail serve una
# "password per app" (non la password normale) e l'IMAP attivo.
# Lascia vuoto MAIL_USER/MAIL_PASS per tenere il ponte spento.
MAIL_HOST=imap.gmail.com
MAIL_USER=
MAIL_PASS=
# MAIL_FILTER=camelcamelcamel   # inoltra solo le email da questo mittente
